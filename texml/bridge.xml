<?xml version="1.0" encoding="UTF-8"?>
<!--
  PhoneZero inline TeXML template — not a hosted bin.

  At call time the caller substitutes {PHONEZERO_XAI_SIP_NUMBER} and
  passes the whole XML string as the Texml field on
  POST /v2/texml/Accounts/{account_sid}/Calls
  (request schema is oneOf: Url XOR Texml XOR neither — do not send Url
  when Texml is set). Telnyx executes these instructions instead of
  fetching a bin URL.

  Recording and restaurant AMD live on the call-creation request, not
  in this XML:
    Record=true, RecordingChannels=dual
    MachineDetection=Enable, AsyncAmd=true

  AMD must not be set on <Sip>: Dial machineDetection classifies the
  DESTINATION of this Dial (the xAI agent), not the restaurant.
-->
<Response>
  <Dial answerOnBridge="true" timeLimit="600">
    <Sip>sip:{PHONEZERO_XAI_SIP_NUMBER}@sip.voice.x.ai;transport=tls</Sip>
  </Dial>
</Response>
